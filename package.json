{
  "name": "markdown-reader",
  "version": "0.1.0",
  "description": "Firefox extension that renders Markdown files as HTML",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "start": "web-ext run",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "serve": "node test/serve.mjs",
    "test": "node test/e2e.mjs"
  },
  "webExt": {
    "ignoreFiles": [
      "node_modules",
      "scripts",
      "test",
      "package.json",
      "package-lock.json",
      "README.md"
    ]
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@mermaid-js/tiny": "^12.3.0",
    "dompurify": "^3.4.17",
    "github-markdown-css": "^5.9.0",
    "katex": "^0.18.10",
    "marked": "^18.1.3",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.13"
  },
  "devDependencies": {
    "selenium-webdriver": "^4.51.0",
    "web-ext": "^10.8.0"
  }
}
